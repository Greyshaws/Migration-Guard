#!/usr/bin/env bash
set -euo pipefail

if [ $# -lt 1 ]; then
    echo "Usage: $0 <admin-contract-address> [output-file]" >&2
    echo "" >&2
    echo "Generates a starter upgrade-guard.toml from an on-chain address." >&2
    echo "" >&2
    echo "Example:" >&2
    echo "  $0 0x9D7b3586f361e3621Bf4F099cBC9d155e8ae6B76" >&2
    exit 1
fi

ADMIN_ADDR="$1"
OUTPUT_FILE="${2:-upgrade-guard.toml}"

if [ -f "$OUTPUT_FILE" ]; then
    echo "Error: $OUTPUT_FILE already exists. Refusing to overwrite." >&2
    echo "Specify a different path or remove the existing file first." >&2
    exit 1
fi

if [ -z "${ETH_RPC_URL:-}" ]; then
    echo "Error: ETH_RPC_URL environment variable is not set." >&2
    exit 1
fi

echo "Reading on-chain state for $ADMIN_ADDR..." >&2

# Verify the address has code
CODE=$(cast code "$ADMIN_ADDR" --rpc-url "$ETH_RPC_URL" 2>/dev/null || echo "0x")
if [ "$CODE" = "0x" ] || [ -z "$CODE" ]; then
    echo "Error: no code at $ADMIN_ADDR on the current chain." >&2
    echo "Either the address is wrong, the contract was selfdestructed," >&2
    echo "or your RPC is pointed at the wrong chain." >&2
    exit 1
fi

# Get current block for the fork block default
CURRENT_BLOCK=$(cast block-number --rpc-url "$ETH_RPC_URL")

# Read storage slot 0 (commonly the owner)
SLOT_0_RAW=$(cast storage "$ADMIN_ADDR" 0 --rpc-url "$ETH_RPC_URL")
# Extract the lower 20 bytes as an address
SLOT_0_ADDR="0x${SLOT_0_RAW: -40}"

# Read EIP-1967 implementation slot
EIP1967_SLOT="0x360894a13ba1a3210667c828492db98dca3e2076cc3735a920a3ca505d382bbc"
IMPL_RAW=$(cast storage "$ADMIN_ADDR" "$EIP1967_SLOT" --rpc-url "$ETH_RPC_URL")
IMPL_ADDR="0x${IMPL_RAW: -40}"

# Check if the contract has tx.origin in its bytecode (a hint for the user)
# Crude check: just look for 0x32 anywhere in the bytecode. The real property
# does proper PUSH-skipping; this is just to flag it in the starter config.
if echo "$CODE" | grep -qi '32'; then
    TX_ORIGIN_HINT="# NOTE: this contract may use tx.origin (ORIGIN opcode detected). Check carefully."
else
    TX_ORIGIN_HINT=""
fi

cat > "$OUTPUT_FILE" <<TOML
# upgrade-guard config
# Generated by 'upgrade-guard init' for address $ADMIN_ADDR
# Edit the TODO sections below before running ./bin/upgrade-guard

[protocol]
name  = "TODO-protocol-name"
chain = "ethereum"

[fork]
# Block to evaluate properties against. Defaults to the current block at init time.
# For pre-deploy CI, you typically set this to the block just before your upgrade lands.
block = $CURRENT_BLOCK

[[admin_contracts]]
name        = "TODO-give-this-a-name"
address     = "$ADMIN_ADDR"
# Storage slot holding the contract owner. Default 0 works for most custom contracts.
# For EIP-1967 transparent proxies, the admin lives at a different slot.
owner_slot  = 0

# ============================================================================
# Property 1: AdminOwnerInApprovedSet
# Checks that the owner of the admin contract is in the approved set.
# ============================================================================
[properties.admin_owner_in_approved_set]
enabled         = true
# TODO: replace with your actual multisig/DAO addresses.
# Currently the owner at slot 0 of $ADMIN_ADDR reads as:
#   $SLOT_0_ADDR
# If that's a legitimate owner address (multisig, DAO, etc.), put it here.
# If that's an attacker address or 0x0, you have a problem already.
approved_owners = ["TODO-replace-with-real-multisig-address"]

# ============================================================================
# Property 2: TxOriginInAuthorization
# Scans deployed bytecode for the ORIGIN opcode (tx.origin authorization).
# No config beyond enabling. Pure static analysis.
# ============================================================================
$TX_ORIGIN_HINT
[properties.tx_origin_in_authorization]
enabled = true

# ============================================================================
# Property 3: OracleDecimalConsistency
# Verifies an oracle's decimals() output matches what a consumer expects.
# Disabled by default. To enable: declare a dependency below AND set enabled=true.
# ============================================================================
[properties.oracle_decimal_consistency]
enabled = false

# Uncomment and fill in to enable Property 3:
# [[dependencies]]
# name              = "primary_oracle"
# address           = "TODO-oracle-address"
# consumers         = ["TODO-consumer-contract-address"]
# expected_decimals = 8  # 8 for Chainlink-style, 18 for many newer oracles

# ============================================================================
# Property 4: StorageLayoutCompatibility
# Verifies the proxy's initialized flag is set and (if EIP-1967) the
# implementation is a deployed contract.
# ============================================================================
[properties.storage_layout_compatibility]
enabled = true
initialized_slot = 0
# EIP-1967 impl slot for $ADMIN_ADDR currently reads as:
#   $IMPL_ADDR
# Leave empty to skip the approved-impls check, or add known-good impl addresses.
approved_impls = []

# ============================================================================
# Property 5: DeadSelectorEnumerator
# Probes the contract with selectors that should revert when called by an
# unauthorized address.
# ============================================================================
[properties.dead_selector_enumerator]
enabled = true
# TODO: list selectors that should be unreachable for unauthorized callers.
# To find selectors for a function: cast sig 'functionName(uint256)'
# Examples (replace with your contract's actual sensitive selectors):
should_be_dead = []

# ============================================================================
# Property 6: LiquidityDecayInvariant
# Verifies the oracle source pool has sufficient liquidity relative to TVL.
# Disabled by default. To enable: fill in the asset/pool addresses below.
# ============================================================================
[properties.liquidity_decay_invariant]
enabled = false
# TODO: set these to your protocol's asset and the DEX pool the oracle reads.
legacy_asset  = "0x0000000000000000000000000000000000000000"
oracle_source = "0x0000000000000000000000000000000000000000"
safety_ratio  = 30000  # 3x in basis points (10000 = 1x)
TOML

echo "" >&2
echo "Created $OUTPUT_FILE" >&2
echo "" >&2
echo "Next steps:" >&2
echo "  1. Open $OUTPUT_FILE and fill in the TODO sections" >&2
echo "  2. Run: ./bin/upgrade-guard $OUTPUT_FILE" >&2
echo "" >&2
echo "Detected state at $ADMIN_ADDR:" >&2
echo "  Storage slot 0 (likely owner): $SLOT_0_ADDR" >&2
echo "  EIP-1967 impl slot:            $IMPL_ADDR" >&2
if [ -n "$TX_ORIGIN_HINT" ]; then
    echo "  Bytecode hint: possible tx.origin usage detected (verify with the property)" >&2
fi
