# Foundry build artifacts (regenerated by forge build)
out/
cache/
broadcast/

# Dependencies (managed by forge install via git submodules)
# Note: lib/ is typically kept as submodules, not committed directly
# Keep this commented if you want lib/forge-std committed.
# Uncomment if you switch to submodules:
# lib/

# Foundry lockfile - opinions differ; mostly safe to commit
# foundry.lock

# Environment files - NEVER commit these
.env
.env.*
*.env

# Secrets and keys
*.key
*.pem
secrets/

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Linux
*~

# Windows
Thumbs.db
ehthumbs.db

# IDE / editor
.vscode/
.idea/
*.swp
*.swo
*~
.history/

# Python (parse-config.py)
__pycache__/
*.pyc
*.pyo
.python-version

# Logs and temp files
*.log
tmp/
/tmp/

# Local config overrides
upgrade-guard.local.toml
